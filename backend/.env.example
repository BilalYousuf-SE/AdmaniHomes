# Copy to .env for local development, or set these as environment variables
# in your hosting provider's dashboard for production. NEVER commit real
# secrets to git.

DATABASE_URL=jdbc:postgresql://localhost:5432/realestate
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Generate a long random string, e.g.: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret-value-min-32-chars
JWT_EXPIRATION_MS=7200000

# Comma separated list, no trailing slashes
CORS_ALLOWED_ORIGINS=http://localhost:5173

# First admin account, created automatically on first boot.
# After first boot you can remove these or change them - the seeder only
# creates the user if it doesn't already exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password

# update on first deploy so Hibernate creates tables; consider switching to
# "validate" after your schema is stable and you introduce real migrations.
DDL_AUTO=update

PORT=8080

# ---- Cloudinary (media uploads) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
